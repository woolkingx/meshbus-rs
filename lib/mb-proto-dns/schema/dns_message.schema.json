{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bus-mesh/schema/dns_message.schema.json",
  "title": "Message",
  "$ref": "#/$defs/Message",
  "$defs": {
    "Name": {
      "type": "string",
      "description": "DNS name in canonical form: ASCII lowercase with trailing dot (RFC 4343). Example: \"www.example.com.\"",
      "pattern": "^([a-z0-9_-]+(\\.[a-z0-9_-]+)*\\.)?$"
    },
    "QType": {
      "type": "string",
      "enum": ["A", "Cname", "Ptr", "Txt", "Aaaa", "Opt", "Any"],
      "description": "DNS query/resource record type (RFC 1035 §3.2.2, RFC 3596, RFC 6891)"
    },
    "RClass": {
      "type": "string",
      "enum": ["In"],
      "description": "DNS record class; only INTERNET (IN=1) is modelled"
    },
    "MessageHeader": {
      "type": "object",
      "required": ["id", "flags"],
      "properties": {
        "id":     { "type": "integer", "minimum": 0, "maximum": 65535, "description": "16-bit message identifier" },
        "flags":  { "type": "integer", "minimum": 0, "maximum": 65535, "description": "16-bit flags word (QR, Opcode, AA, TC, RD, RA, Z, RCODE)" },
        "qdcount":{ "type": "integer", "minimum": 0, "maximum": 65535 },
        "ancount":{ "type": "integer", "minimum": 0, "maximum": 65535 },
        "nscount":{ "type": "integer", "minimum": 0, "maximum": 65535 },
        "arcount":{ "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "Question": {
      "type": "object",
      "required": ["name", "qtype", "qclass"],
      "properties": {
        "name":   { "$ref": "#/$defs/Name" },
        "qtype":  { "$ref": "#/$defs/QType" },
        "qclass": { "$ref": "#/$defs/RClass" }
      }
    },
    "RData": {
      "oneOf": [
        {
          "type": "object",
          "required": ["A"],
          "properties": { "A": { "type": "string", "format": "ipv4", "description": "IPv4 address" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Aaaa"],
          "properties": { "Aaaa": { "type": "string", "format": "ipv6", "description": "IPv6 address" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Ptr"],
          "properties": { "Ptr": { "$ref": "#/$defs/Name" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Cname"],
          "properties": { "Cname": { "$ref": "#/$defs/Name" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Txt"],
          "properties": {
            "Txt": { "type": "array", "items": { "type": "string" }, "description": "TXT string segments" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Opt"],
          "properties": {
            "Opt": {
              "type": "object",
              "required": ["udp_payload_size", "ext_rcode", "edns_version", "flags", "options"],
              "properties": {
                "udp_payload_size": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "ext_rcode":        { "type": "integer", "minimum": 0, "maximum": 255 },
                "edns_version":     { "type": "integer", "minimum": 0, "maximum": 255 },
                "flags":            { "type": "integer", "minimum": 0, "maximum": 65535 },
                "options":          { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Opaque"],
          "properties": {
            "Opaque": {
              "type": "object",
              "required": ["qtype", "raw"],
              "properties": {
                "qtype": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "raw":   { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ResourceRecord": {
      "type": "object",
      "required": ["name", "qtype", "qclass", "ttl", "data"],
      "properties": {
        "name":   { "$ref": "#/$defs/Name" },
        "qtype":  { "$ref": "#/$defs/QType" },
        "qclass": { "$ref": "#/$defs/RClass" },
        "ttl":    { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Time-to-live in seconds" },
        "data":   { "$ref": "#/$defs/RData" }
      }
    },
    "Message": {
      "type": "object",
      "required": ["header", "questions", "answers", "authorities", "additionals"],
      "properties": {
        "header":      { "$ref": "#/$defs/MessageHeader" },
        "questions":   { "type": "array", "items": { "$ref": "#/$defs/Question" } },
        "answers":     { "type": "array", "items": { "$ref": "#/$defs/ResourceRecord" } },
        "authorities": { "type": "array", "items": { "$ref": "#/$defs/ResourceRecord" } },
        "additionals": { "type": "array", "items": { "$ref": "#/$defs/ResourceRecord" } }
      }
    },
    "EdnsConfig": {
      "type": "object",
      "required": ["udp_payload_size", "dnssec_ok"],
      "properties": {
        "udp_payload_size": {
          "type": "integer",
          "minimum": 512,
          "maximum": 65535,
          "default": 1232,
          "description": "Advertised UDP payload size; 1232 is DNS Flag Day 2020 recommendation"
        },
        "dnssec_ok": {
          "type": "boolean",
          "default": false,
          "description": "Set the DO bit in OPT pseudo-RR to request DNSSEC records"
        }
      }
    }
  }
}
