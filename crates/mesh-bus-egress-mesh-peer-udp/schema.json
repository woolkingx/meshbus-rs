{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-bus-egress-mesh-peer-udp/schema.json",
  "title": "mesh-bus-egress-mesh-peer-udp",
  "description": "Configured adjacent MeshPeer upstream egress. Runtime capability is stream + datagram; payload remains opaque Mesh Protocol SDU.",
  "type": "object",
  "required": ["id", "peer_id", "peer", "timeout_ms"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$" },
    "peer_id": { "type": "string", "minLength": 1 },
    "peer": { "type": "string", "minLength": 1 },
    "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "mesh_packetizer": {
      "type": "object",
      "description": "Egress-local adjacent-peer sender. It owns MeshFrame control/data queue split and flush timing before handing opaque datagrams to UdpPacketLoop.",
      "additionalProperties": false,
      "properties": {
        "owner_layer": { "const": "L5/L4-sender" },
        "packetizer_ref": { "const": "lib/mb-proto-mesh/schema.json#/properties/mesh_packetizer_v1" },
        "control_queue_bound": { "type": "integer", "minimum": 1 },
        "data_queue_bound": { "type": "integer", "minimum": 1 },
        "control_flush_max_delay_us": { "const": 0 },
        "data_flush_batch_datagrams": { "const": 32 },
        "data_flush_max_delay_us": { "const": 250 },
        "data_budget_source": { "const": "path_controller_v1" },
        "queue_full_failure": { "const": "QueueFull" },
        "socket_owner": { "const": "UdpPacketLoop" }
      },
      "required": [
        "owner_layer",
        "packetizer_ref",
        "control_queue_bound",
        "data_queue_bound",
        "control_flush_max_delay_us",
        "data_flush_batch_datagrams",
        "data_flush_max_delay_us",
        "data_budget_source",
        "queue_full_failure",
        "socket_owner"
      ]
    },
    "demux_driver": {
      "type": "object",
      "description": "Egress-local L5 receive projection. The canonical FamilyReorderState shape is lib/mb-proto-mesh/schema.json#/properties/family_state_v1; this object only declares the adapter-owned driver queues and bounds.",
      "additionalProperties": false,
      "properties": {
        "owner_layer": { "const": "L5" },
        "family_state_ref": { "const": "lib/mb-proto-mesh/schema.json#/properties/family_state_v1" },
        "family_key": {
          "type": "array",
          "prefixItems": [
            { "const": "peer" },
            { "const": "family_id" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "control_inbox_bound": { "type": "integer", "minimum": 1 },
        "data_inbox_bound": { "type": "integer", "minimum": 1 },
        "event_inbox_bound": { "type": "integer", "minimum": 1 },
        "datagram_inbox_bound": { "type": "integer", "minimum": 1 },
        "repair_control_bound": { "type": "integer", "minimum": 1 },
        "control_feedback_owner": {
          "const": "bounded_control_worker",
          "description": "AckNack and repair retransmit intents are queued to a bounded worker; demux/data delivery must not await packet_loop.flush."
        },
        "deliver_outcome": {
          "type": "string",
          "enum": ["control_inbox", "delivered_data", "stream_event", "datagram_return", "repair_intent", "queue_full"]
        }
      },
      "required": [
        "owner_layer",
        "family_state_ref",
        "family_key",
        "control_inbox_bound",
        "data_inbox_bound",
        "event_inbox_bound",
        "datagram_inbox_bound",
        "repair_control_bound",
        "control_feedback_owner"
      ]
    }
  }
}
