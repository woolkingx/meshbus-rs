{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-bus-observer-prometheus/schema.json",
  "title": "mesh-bus-observer-prometheus",
  "description": "Prometheus observer config for per-exit dispatch telemetry.",
  "x-schema-version": "draft-07",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "PrometheusTextfile" },
        "path": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "listen"],
      "properties": {
        "kind": { "const": "PrometheusHttp" },
        "listen": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  ]
}
