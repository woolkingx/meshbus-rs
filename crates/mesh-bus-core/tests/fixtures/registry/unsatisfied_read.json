{
  "name": "unsatisfied_read",
  "params": { "layer": "registry", "exercise": "verify" },
  "input": {
    "json": {
      "sources": [{ "id": "src", "kind": "application/source", "initial_writes": [] }],
      "sinks": [{ "id": "direct", "kind": "stream_egress" }],
      "hooks": [
        { "id": "reader", "kind": "Policy", "allowed_namespaces": ["policy.*"], "reads": ["policy.route_group"], "writes": [], "may_terminate": true, "may_jump": false, "may_jump_to": [], "may_accept_to": [], "side_effect_only": false }
      ],
      "pipelines": [{ "id": "main", "hooks": ["reader"] }],
      "wirings": [{ "source": "src", "pipeline": "main" }]
    }
  },
  "expect": { "ok": false, "error_contains": "not satisfied by source or prior write" }
}
