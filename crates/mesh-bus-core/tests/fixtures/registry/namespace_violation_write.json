{
  "name": "namespace_violation_write",
  "params": { "layer": "registry", "exercise": "verify" },
  "input": {
    "json": {
      "sources": [{ "id": "src", "kind": "application/source", "initial_writes": [] }],
      "sinks": [{ "id": "direct", "kind": "stream_egress" }],
      "hooks": [
        { "id": "pol_ns", "kind": "Policy", "allowed_namespaces": ["policy.*"], "reads": [], "writes": ["net.something"], "may_terminate": false, "may_jump": false, "may_jump_to": [], "may_accept_to": [], "side_effect_only": false },
        { "id": "allow", "kind": "Net", "allowed_namespaces": [], "reads": [], "writes": [], "may_terminate": true, "may_jump": false, "may_jump_to": [], "may_accept_to": [], "side_effect_only": false }
      ],
      "pipelines": [{ "id": "main", "hooks": ["pol_ns", "allow"] }],
      "wirings": [{ "source": "src", "pipeline": "main" }]
    }
  },
  "expect": { "ok": false, "error_contains": "namespace restriction" }
}
